#!/usr/bin/env bash
set -euo pipefail
prompt="${*:-}"
if [ -z "$prompt" ]; then
  echo "usage: maestro-claude <prompt>" >&2
  exit 2
fi
# --safe-mode disables Claude customizations (CLAUDE.md, skills, hooks, MCP).
# It is not an OS/network sandbox. Isolation is plan mode + Read-only tools.
content="$(claude -p --permission-mode plan --tools Read --no-session-persistence --safe-mode "$prompt")"
printf '%s\n' "$content"
python3 - "$prompt" "$content" <<'PY'
import json, os, sys
from datetime import datetime, timezone
from pathlib import Path
prompt, content = sys.argv[1], sys.argv[2]
event = {
    "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    "lane": "claude",
    "model": "claude-cli",
    "message": "Claude CLI call",
    "input_tokens": max(1, len(prompt)//4),
    "output_tokens": max(1, len(content)//4),
}
event["total_tokens"] = event["input_tokens"] + event["output_tokens"]
if os.environ.get("NIGHTSHIFT_HOME"):
    data_home = Path(os.environ["NIGHTSHIFT_HOME"]).expanduser()
elif os.environ.get("XDG_DATA_HOME"):
    data_home = Path(os.environ["XDG_DATA_HOME"]).expanduser() / "nightshift"
elif os.environ.get("CODEX_HOME"):
    data_home = Path(os.environ["CODEX_HOME"]).expanduser()
else:
    legacy = Path.home() / ".codex"
    if (legacy / "night-shift").exists() or (legacy / "bin" / "night-shift").exists():
        data_home = legacy
    else:
        data_home = Path.home() / ".local" / "share" / "nightshift"
path = data_home / "maestro-sidecar" / "events.jsonl"
path.parent.mkdir(parents=True, exist_ok=True)
with path.open("a", encoding="utf-8") as f:
    f.write(json.dumps(event, sort_keys=True)+"\n")
PY
